{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "avemguvern-ro",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "vars": {
    // Edge-cache TTL (seconds) for GET /api/status. 0 disables caching.
    "CACHE_TTL_SECONDS": 60
  },
  "kv_namespaces": [
    {
      "binding": "GOV_STATUS",
      "id": "f188c870bc9843969ab26c2d63db6b36"
    }
  ],
  // Crowd-sourced joke suggestions live in their own D1 database.
  // Create it with: npx wrangler d1 create avemguvern-suggestions
  // then paste the returned database_id below and apply schema.sql.
  "d1_databases": [
    {
      "binding": "SUGGESTIONS",
      "database_name": "avemguvern-suggestions",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  // Native per-IP rate limiting. namespace_id is any number unique to this
  // account; period must be 10 or 60 (seconds).
  "unsafe": {
    "bindings": [
      {
        "name": "READ_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 120, "period": 60 }
      },
      {
        "name": "WRITE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1002",
        "simple": { "limit": 10, "period": 60 }
      }
    ]
  }
  // ADMIN_TOKEN is set as a secret, not here:
  //   npx wrangler secret put ADMIN_TOKEN
  //
  // To attach the custom domain after the first deploy, either use the
  // Cloudflare dashboard (Workers > your worker > Domains & Routes) or add:
  // "routes": [{ "pattern": "avemguvern.ro", "custom_domain": true }]
}
